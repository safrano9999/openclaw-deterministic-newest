+/** Keeps published model-list reads free of runtime activation and repeated policy scans. */
+import { afterEach, describe, expect, it, vi } from "vitest";
+import type { ModelsListParams } from "../../../packages/gateway-protocol/src/schema/agents-models-skills.js";
+import * as modelAuth from "../../agents/model-auth-availability.js";
+import type { ModelCatalogEntry, ModelCatalogSnapshot } from "../../agents/model-catalog.types.js";
+import * as runtimeConfig from "../../config/config.js";
+import type { AgentModelEntryConfig } from "../../config/types.agent-defaults.js";
+import type { ModelDefinitionConfig, ModelProviderConfig } from "../../config/types.models.js";
+import type { OpenClawConfig } from "../../config/types.openclaw.js";
+import * as gateway from "../../gateway/call.js";
+import {
+  buildModelsListResult,
+  createGatewayAgentModelCatalogProjector,
+} from "../../gateway/server-methods/models-list-result.js";
+import type { GatewayRequestContext } from "../../gateway/server-methods/types.js";
+import { withPluginMetadataSnapshotScope } from "../../plugins/current-plugin-metadata-snapshot.js";
+import {
+  bindPluginMetadataSnapshotCache,
+  createPluginCache,
+  withPluginCache,
+} from "../../plugins/plugin-cache.js";
+import { clearPluginMetadataLifecycleCaches } from "../../plugins/plugin-metadata-lifecycle.js";
+import { createPluginMetadataSnapshotFixture } from "../../plugins/plugin-metadata.test-support.js";
+import { createEmptyPluginRegistry } from "../../plugins/registry-empty.js";
+import { resetPluginRuntimeStateForTest } from "../../plugins/runtime.js";
+import type { ProviderPlugin } from "../../plugins/types.js";
+import { modelsListCommand } from "./list.list-command.js";
+import type { ModelRow } from "./list.types.js";
+
+const mocks = vi.hoisted(() => ({
+  getRuntimePluginRegistryForLoadOptions: vi.fn(),
+}));
+
+// Published catalog reads must not materialize runtime providers. The separate
+// provider activation tests cover preparation and operation-cache freshness.
+vi.mock("../../plugins/providers.runtime.js", async () => {
+  const { createProviderRegistryResolver } =
+    await import("../../plugins/providers.runtime-core.js");
+  return createProviderRegistryResolver({
+    resolveRuntimePluginRegistry: mocks.getRuntimePluginRegistryForLoadOptions,
+    isPluginRegistryLoadInFlight: () => false,
+    loadOpenClawPlugins: () => {
+      throw new Error("model-list projection must not activate a plugin registry");
+    },
+  });
+});
+
+vi.mock("../../plugins/provider-hook-runtime.js", async () => {
+  const { createProviderHookRuntime } = await import("../../plugins/provider-hook-runtime-core.js");
+  const providers = await import("../../plugins/providers.runtime.js");
+  return createProviderHookRuntime(providers);
+});
+
+vi.mock("../../plugins/provider-public-artifacts.js", () => ({
+  resolveBundledProviderPolicySurface: () => null,
+  resolveProviderPolicySurface: () => null,
+}));
+
+type ListView = {
+  name: string;
+  all: boolean;
+  sourceProvider: string;
+  providerFilter?: string;
+  replace?: boolean;
+};
+
+function createConfiguredModel(id: string): ModelDefinitionConfig {
+  return {
+    id,
+    name: `Authored ${id}`,
+    input: ["text", "image"],
+    reasoning: false,
+    cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
+    contextWindow: 64_000,
+    maxTokens: 4096,
+  };
+}
+
+async function renderConfiguredRows(modelCount: number, view: ListView, includeDiscovery: boolean) {
+  clearPluginMetadataLifecycleCaches();
+  resetPluginRuntimeStateForTest();
+  let policyMapScans = 0;
+  const models = Array.from({ length: modelCount }, (_, index) =>
+    createConfiguredModel(`model-${index}`),
+  );
+  const modelEntries = new Proxy<Record<string, AgentModelEntryConfig>>(
+    Object.fromEntries(
+      models.map((model, index) => [
+        `${view.sourceProvider}/${model.id}`,
+        index === 0 ? { alias: "Primary" } : {},
+      ]),
+    ),
+    {
+      ownKeys(target) {
+        policyMapScans += 1;
+        return Reflect.ownKeys(target);
+      },
+    },
+  );
+  const providerConfig: ModelProviderConfig = {
+    api: "openai-completions",
+    baseUrl: "https://models.example.test/v1",
+    models,
+  };
+  const cfg: OpenClawConfig = {
+    agents: {
+      defaults: {
+        model: {
+          primary: `${view.sourceProvider}/model-0`,
+          fallbacks: [`${view.sourceProvider}/model-1`],
+        },
+        models: modelEntries,
+      },
+    },
+    models: {
+      mode: view.replace ? "replace" : "merge",
+      providers: {
+        [view.sourceProvider]: providerConfig,
+        other: { ...providerConfig, models: [createConfiguredModel("other-model")] },
+      },
+    },
+  };
+  const metadataSnapshot = {
+    ...createPluginMetadataSnapshotFixture({
+      plugins: [
+        {
